<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:utils="clr-namespace:BanglaTracker.Presentation.Utils;assembly=BanglaTracker.Presentation"
             x:Class="BanglaTracker.Presentation.Views.JourneySearchPage"
             Title="Journey Search Page">
    <ContentPage.Resources>
        <utils:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </ContentPage.Resources>
    
    <VerticalStackLayout Padding="20">
        <!-- From Station -->
        <Label Text="From" FontAttributes="Bold"/>
        <Picker Title="Select from station"
                ItemsSource="{Binding Stations}" 
                ItemDisplayBinding="{Binding Name}"
                SelectedItem="{Binding SelectedFromStation}" />

        <!-- To Station -->
        <Label Text="To" FontAttributes="Bold"/>
        <Picker Title="Select to station"
                ItemsSource="{Binding Stations}" 
                ItemDisplayBinding="{Binding Name}"
                SelectedItem="{Binding SelectedToStation}" />
       
        <!-- Select Train -->
        <Label Text="Train Name" FontAttributes="Bold" />
        <Picker Title="Select train"
                ItemsSource="{Binding Trains}"
                ItemDisplayBinding="{Binding Name}"
                SelectedItem="{Binding SelectedTrain}" />
        
        <!-- Current Station -->
        <Label Text="Current Station" FontAttributes="Bold"/>
        <Picker Title="Select current station"
                ItemsSource="{Binding Stations}"
                ItemDisplayBinding="{Binding Name}"
                SelectedItem="{Binding SelectedCurrentStation}" />

        <!-- Submit Button -->
        <Button Text="Search Train" 
                Command="{Binding SearchCommand}"
                IsEnabled="{Binding IsNavigating, Converter={StaticResource InverseBooleanConverter}}"
                BackgroundColor="RoyalBlue" 
                TextColor="White" 
                CornerRadius="10" 
                Margin="0,20,0,0"/>
    </VerticalStackLayout>
</ContentPage>
