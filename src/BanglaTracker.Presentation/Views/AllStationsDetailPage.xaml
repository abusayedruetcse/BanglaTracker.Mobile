<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BanglaTracker.Presentation.Views.AllStationsDetailPage"
             Title="All Station Details">

    <ContentPage.Content>
        <CollectionView ItemsSource="{Binding Stations}"
                        SelectionMode="None"
                        Margin="10"
                        BackgroundColor="White">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="5" BorderColor="Gray" CornerRadius="8">
                        <Grid ColumnDefinitions="2*,1*,1*"
                              RowDefinitions="Auto,Auto" Padding="0">

                            <!-- Station Name -->
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding StationName}"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="Black" />

                            <!-- Arrival Time Remaining -->
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding ArrivalTime}"
                                   FontSize="14"
                                   TextColor="RoyalBlue" 
                                   HorizontalOptions="End" />

                            <!-- Average Break Time -->
                            <Label Grid.Row="1" Grid.Column="2"
                                   Text="{Binding BreakTime}"
                                   FontSize="14"
                                   TextColor="Green"
                                   HorizontalOptions="End" />

                            <!-- Decorative Icons or Images (Optional) -->
                            <Image Source="Resources/Images/clock_icon.png" Grid.Row="1" Grid.Column="0"
                                   WidthRequest="20" HeightRequest="20"
                                   VerticalOptions="Center" Margin="5,0,0,0"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </ContentPage.Content>
</ContentPage>
